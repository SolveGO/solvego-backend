DB_USERNAME=solvego
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-secret-key
# Required in prod: exact HTTPS frontend origin(s), comma-separated, no trailing slash.
# Set this to the actual deployed frontend; no CloudFront hostname is assumed.
CORS_ALLOWED_ORIGINS=
AI_EXPLANATION_FREE_DAILY_LIMIT=5
AI_EXPLANATION_PRO_DAILY_LIMIT=30
AI_EXPLANATION_TIME_ZONE=Asia/Seoul

# Toss Billing secret from the developer console (never commit real keys).
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_BASE_URL=https://api.tosspayments.com
TOSS_PAYMENTS_CONNECT_TIMEOUT=5s
# Must be at least 60s for billing approval.
TOSS_PAYMENTS_READ_TIMEOUT=65s

PRO_MONTHLY_AMOUNT=5000
# Base64 of a random 32-byte key. Keep stable; never commit the real key.
BILLING_KEY_ENCRYPTION_KEY=
